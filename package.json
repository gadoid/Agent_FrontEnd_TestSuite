  "private": true,
  "license": "ISC",
  "description": "SparkSeed（sparkseed.exe，官方 DeepSeek Harness v0.2.0-rc.8）Playwright 双端自动化测试套件",
  "scripts": {
    "test": "playwright test --project=web-chromium && playwright test --project=electron",
    "test:web": "playwright test --project=web-chromium",
    "test:web:headed": "playwright test --project=web-chromium --headed",
    "test:electron": "playwright test --project=electron",
    "report": "playwright show-report",
    "report:export": "node scripts/export-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
