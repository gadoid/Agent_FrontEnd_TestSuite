# ============================================================
# SparkSeed 桌面客户端测试套件 —— 环境配置模板
#
# 迁移到新 PC 时：复制本文件为 .env 并按实际情况填写。
# 命令行/CI 已设置的同名环境变量优先于本文件。
#
# ⚠️⚠️ 键名只能用 E2E_ 前缀 ⚠️⚠️
# sparkseed（官方 DeepSeek Harness v0.2.0-rc.8）启动时会读取**当前工作目录**的 .env，
# 并拒绝其中出现「只有启动环境才能设置」的变量，一旦命中就抛错退出，表现为应用根本起不来：
#
#   Error: dsh: <path>/.env sets "DSH_XXX", which only the launching environment
#   may set ...; export DSH_XXX instead of putting it in a .env file
#
# 禁止的前缀：DSH_ / XDG_ / DYLD_ / BASH_FUNC_
# 禁止的其它名字：PATH / HOME / NODE_OPTIONS / NODE_PATH / LD_PRELOAD /
#                 LD_LIBRARY_PATH / HTTP_PROXY / HTTPS_PROXY / NO_PROXY / ALL_PROXY
#
# 确实需要给应用传 DSH_* 时，用真实环境变量 export，不要写进 .env。
# fixtures/env.js 的 assertEnvFileSafe() 会在加载时拦截违规键名并给出明确报错。
# ============================================================

# --- 桌面端可执行文件（SparkSeed） ---
# 正反斜杠均可（夹具会归一化）。不设时按常见安装位置自动探测（含 D:/sparkseed/sparkseed.exe）。
E2E_DSH_EXE=D:/sparkseed/sparkseed.exe

# --- web 形态服务地址与监听参数 ---
# 套件会自行拉起 `dsh web`（见 fixtures/web-server.js）；E2E_URL 的端口必须与
# E2E_WEB_PORT 一致——认证 cookie 的名字由 "host:port" 派生，端口对不上必然 401。
E2E_URL=http://127.0.0.1:3080
E2E_WEB_HOST=127.0.0.1
E2E_WEB_PORT=3080

# --- 业务数据 HOME（profile/凭据/会话所在目录）；留空 = ~/.sparkseed ---
# 对桌面端与 dsh web 子进程同时生效（翻译为应用的 DSH_HOME）
# 注意：sparkseed 的 cookie 签名密钥**不落盘**，无法离线构造登录态；
# web 登录走 token 流程（套件自动从 `dsh web` 启动输出捕获）。
E2E_DSH_HOME=

# --- 传给桌面端主进程的额外参数（可选，空格分隔） ---
E2E_ELECTRON_ARGS=

# --- 运行期开关 ---
# 1 = 不启动 web 服务（连接已在跑的服务）；此时需手工提供 E2E_TOKEN
E2E_SKIP_SERVER_START=
# 1 = 复用 pidfile 里残留的服务，而不是杀掉重建
E2E_REUSE_SERVER=

# --- 报告增强 ---
# 快用例的最短观测时长（毫秒）：执行完到结束截图不足该时长时补足等待，
# 避免「一闪而过」的自动化执行看不出过程。仅对通过的用例生效；0 = 关闭。默认 6000
E2E_MIN_TEST_MS=6000

# --- web 登录 token（可选） ---
# `dsh web` 每次启动都会打印 `dsh web: http://127.0.0.1:3080/?token=xxx`。
# 套件起服务时会自动捕获，通常无需填写；仅当 E2E_SKIP_SERVER_START=1 连外部服务时才手工提供。
E2E_TOKEN=

# --- LLM key（可选） ---
# 当前部署若走内置中转 provider（settings 内置）则无需额外凭据。
# 仅在部署切回官方 deepseek-account 路由时才需要：注入为 DEEPSEEK_API_KEY。
E2E_LLM_API_KEY=
